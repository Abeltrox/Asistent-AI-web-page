# Copia este archivo como .env y coloca tu clave de la API de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Modelo de OpenAI a usar
OPENAI_MODEL=gpt-5-mini
# Límite de tokens que puede generar cada respuesta de Braqui
OPENAI_MAX_TOKENS=12000
# Esfuerzo de razonamiento (solo modelos gpt-5* / o*): minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# URL del backend Spring Boot (de donde se leen los dinosaurios para el RAG)
BACKEND_URL=http://localhost:8080
# Cada cuántos segundos se refresca el índice con los dinosaurios de la base de datos
REINDEX_SEGUNDOS=60
